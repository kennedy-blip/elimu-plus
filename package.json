{
  "name": "elimu-plus",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && python3 -m http.server ${PORT:-8000} --bind 0.0.0.0 --directory dist",
    "dev:react": "vite",
    "build": "python3 -m venv .venv && .venv/bin/python -m pip install --disable-pip-version-check -r static-site/requirements.txt && .venv/bin/python static-site/render_build.py",
    "build:react": "vite build",
    "preview": "python3 -m http.server ${PORT:-8000} --bind 0.0.0.0 --directory dist",
    "preview:react": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^22.19.7",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
